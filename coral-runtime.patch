From 7f6eca15fbd27cd5f0d6834d895294d8fab621e8 Mon Sep 17 00:00:00 2001
From: SanjaySivaA <realsanjaysiva@gmail.com>
Date: Wed, 18 Nov 2026 16:21:35 +0530
Subject: [PATCH] Add custom host runtime and build target for DTCM extraction

---
 sim/BUILD            |  23 +++++++++-
 sim/coral_runtime.cc | 103 +++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 124 insertions(+), 2 deletions(-)
 create mode 100644 sim/coral_runtime.cc

diff --git a/sim/BUILD b/sim/BUILD
index 799ca9f..6685b29 100644
--- a/sim/BUILD
+++ b/sim/BUILD
@@ -14,8 +14,6 @@
 
 # Build rules for CoralNPU simulator code.
 load("@mpact-sim//mpact/sim/decoder:mpact_sim_isa.bzl", "mpact_bin_fmt_decoder", "mpact_isa_decoder")
-# load("@rules_cc//cc:defs.bzl", "cc_binary")
-# load("@rules_cc//cc:defs.bzl", "cc_library")
 
 package(default_visibility = ["//visibility:public"])
 
@@ -642,3 +640,24 @@ cc_library(
         "@mpact-sim//mpact/sim/generic:type_helpers",
     ],
 )
+
+cc_binary(
+    name = "coral_runtime",
+    srcs = ["coral_runtime.cc"],
+    copts = ["-O3"],
+    deps = [
+        ":coralnpu_simulator",
+        ":coralnpu_v2_state",
+        "@abseil-cpp//absl/flags:flag",
+        "@abseil-cpp//absl/flags:marshalling",
+        "@abseil-cpp//absl/flags:parse",
+        "@abseil-cpp//absl/flags:usage",
+        "@abseil-cpp//absl/log",
+        "@abseil-cpp//absl/log:initialize",
+        "@abseil-cpp//absl/strings",
+        "@abseil-cpp//absl/strings:str_format",
+        "@abseil-cpp//absl/strings:string_view",
+        "@abseil-cpp//absl/time",
+        "@mpact-sim//mpact/sim/generic:type_helpers",
+    ],
+)
\ No newline at end of file
diff --git a/sim/coral_runtime.cc b/sim/coral_runtime.cc
new file mode 100644
index 0000000..0c2cc54
--- /dev/null
+++ b/sim/coral_runtime.cc
@@ -0,0 +1,103 @@
+#include <iostream>
+#include <fstream>
+#include <iomanip>
+#include <vector>
+#include <cstdint>
+#include <string>
+
+#include "absl/flags/flag.h"
+#include "absl/flags/parse.h"
+#include "absl/flags/usage.h"
+#include "absl/log/initialize.h"
+
+#include "sim/coralnpu_simulator.h"
+
+ABSL_FLAG(std::string, elf, "", "Path to target ELF binary");
+ABSL_FLAG(uint64_t, dtcm_addr, 0x00010000, "DTCM base address for output extraction");
+ABSL_FLAG(size_t, size, 32, "Size of DTCM result buffer to read in bytes");
+ABSL_FLAG(std::string, out, "", "Output binary file path");
+ABSL_FLAG(bool, print_stdout, true, "Print extracted DTCM words to stdout");
+
+using ::coralnpu::sim::CoralNPUSimulator;
+using ::coralnpu::sim::CoralNPUSimulatorOptions;
+
+int main(int argc, char** argv) {
+  absl::InitializeLog();
+  absl::SetProgramUsageMessage("CoralNPU V2 Custom Host Runtime");
+  auto args = absl::ParseCommandLine(argc, argv);
+
+  std::string elf_path = absl::GetFlag(FLAGS_elf);
+  if (elf_path.empty() && args.size() > 1) {
+    elf_path = args[1];
+  }
+
+  if (elf_path.empty()) {
+    std::cerr << "[Error] Please provide a path to an ELF binary." << std::endl;
+    return 1;
+  }
+
+  uint64_t dtcm_addr = absl::GetFlag(FLAGS_dtcm_addr);
+  size_t size = absl::GetFlag(FLAGS_size);
+  std::string out_path = absl::GetFlag(FLAGS_out);
+  bool print_stdout = absl::GetFlag(FLAGS_print_stdout);
+
+  // 1. Configure options and instantiate simulator
+  CoralNPUSimulatorOptions options;
+  CoralNPUSimulator simulator(options);
+
+  // 2. Load target ELF program
+  auto load_status = simulator.LoadProgram(elf_path);
+  if (!load_status.ok()) {
+    std::cerr << "[Error] Failed to load ELF: " << load_status.message() << std::endl;
+    return 1;
+  }
+
+  // 3. Run execution until completion / ebreak
+  std::cout << "[Runtime] Running simulator on " << elf_path << "..." << std::endl;
+  auto run_status = simulator.Run();
+  if (!run_status.ok()) {
+    std::string err_msg(run_status.message());
+    std::cout << "[Runtime] Simulation completed with status: " << err_msg << std::endl;
+  } else {
+    std::cout << "[Runtime] Simulation completed successfully." << std::endl;
+  }
+
+  // 4. Read DTCM memory directly from target address
+  std::vector<uint8_t> buffer(size, 0);
+  auto read_result = simulator.ReadMemory(dtcm_addr, buffer.data(), size);
+  if (!read_result.ok()) {
+    std::cerr << "[Error] Failed to read DTCM memory at 0x" 
+              << std::hex << dtcm_addr << std::dec << ": " << read_result.status().message() << std::endl;
+    return 1;
+  }
+
+  // 5. Save raw binary output if requested
+  if (!out_path.empty()) {
+    std::ofstream out_file(out_path, std::ios::binary);
+    if (out_file.is_open()) {
+      out_file.write(reinterpret_cast<const char*>(buffer.data()), buffer.size());
+      out_file.close();
+      std::cout << "[Runtime] Wrote " << buffer.size() << " bytes to " << out_path << std::endl;
+    }
+  }
+
+  // 6. Print formatted DTCM 32-bit words to stdout
+  if (print_stdout) {
+    std::cout << "\n==================================================" << std::endl;
+    std::cout << "  DTCM Output Buffer [Addr: 0x" 
+              << std::hex << std::setw(8) << std::setfill('0') << dtcm_addr << "]" << std::dec << std::endl;
+    std::cout << "==================================================" << std::endl;
+
+    const uint32_t* words = reinterpret_cast<const uint32_t*>(buffer.data());
+    size_t num_words = size / sizeof(uint32_t);
+
+    for (size_t i = 0; i < num_words; ++i) {
+      std::cout << "  [+0x" << std::setw(4) << std::setfill('0') << std::hex << (i * 4) << "]: 0x"
+                << std::setw(8) << std::setfill('0') << words[i] 
+                << "  (" << std::dec << words[i] << ")\n";
+    }
+    std::cout << "==================================================" << std::endl;
+  }
+
+  return 0;
+}
\ No newline at end of file
-- 
